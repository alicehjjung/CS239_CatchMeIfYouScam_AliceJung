RAKAZO_EMAIL=your-local-rakazo-email
RAKAZO_PASSWORD=your-local-rakazo-password
PAYMENTS_BOT_ID=your-payments-bot-id
RAKAZO_URL=http://localhost:23100
RAKAZO_ORIGIN=http://127.0.0.1:5173
PAYMENTS_A2A_URL=http://127.0.0.1:9999

# Rakazo runs in Docker; MCP servers run on the host.
ASSISTANT_MCP_URL=http://host.docker.internal:8766/mcp
PAYMENTS_MCP_URL=http://host.docker.internal:8767/mcp

# Server binding and connection settings
ASSISTANT_MCP_HOST=0.0.0.0
ASSISTANT_MCP_PORT=8766
PAYMENTS_MCP_HOST=0.0.0.0
PAYMENTS_MCP_PORT=8767
PAYMENTS_A2A_HOST=127.0.0.1
PAYMENTS_A2A_PORT=9999
